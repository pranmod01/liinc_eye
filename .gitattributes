# Git Attributes for LIINC Eye-Tracking Project

# =============================================================================
# Jupyter Notebooks
# =============================================================================
# Notebooks are tracked with outputs for review purposes, but can be stripped
# using nbconvert or git filters if needed

*.ipynb linguist-documentation=false
*.ipynb linguist-detectable=true

# Optional: Configure git-lfs for large notebooks if needed
# *.ipynb filter=lfs diff=lfs merge=lfs -text

# =============================================================================
# Data Files
# =============================================================================

# CSV files - track with standard diff
*.csv text eol=lf

# Large data files - consider LFS if repository grows
# Uncomment these lines and install git-lfs if needed:
# *.pkl filter=lfs diff=lfs merge=lfs -text
# *.h5 filter=lfs diff=lfs merge=lfs -text
# *.hdf5 filter=lfs diff=lfs merge=lfs -text
# *.npy filter=lfs diff=lfs merge=lfs -text
# *.npz filter=lfs diff=lfs merge=lfs -text

# =============================================================================
# Configuration Files
# =============================================================================

*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# =============================================================================
# Python Files
# =============================================================================

*.py text eol=lf diff=python
*.pyx text eol=lf diff=python
*.pyi text eol=lf diff=python

# =============================================================================
# Documentation
# =============================================================================

*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
README text eol=lf

# =============================================================================
# Images and Figures
# =============================================================================

# Images are binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Publication figures - track but treat as binary
*.pdf binary
*.eps binary

# =============================================================================
# Archive Files
# =============================================================================

*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary

# =============================================================================
# Shell Scripts
# =============================================================================

*.sh text eol=lf
*.bash text eol=lf

# Make scripts executable
*.sh eol=lf
*.bash eol=lf

# =============================================================================
# GitHub Specific
# =============================================================================

# Export-ignore: exclude these from release archives
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
tests/ export-ignore
*.test.py export-ignore

# =============================================================================
# Line Ending Normalization
# =============================================================================

# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.c text
*.h text

# Declare files that will always have CRLF line endings on checkout
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Denote all files that are truly binary and should not be modified
*.db binary
*.p binary
*.pkl binary
*.pyc binary
*.pyo binary
*.pyd binary

# =============================================================================
# Special Handling
# =============================================================================

# Jupyter notebook metadata - merge driver to avoid conflicts
# To enable: git config merge.ours.driver true
# *.ipynb merge=ours

# Language statistics
*.ipynb linguist-language=Jupyter-Notebook
*.py linguist-language=Python
